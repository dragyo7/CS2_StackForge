# StackForge Server Environment Configuration (Optional)
# Copy to .env and fill in keys if you want live provider enrichment.
# StackForge works 100% offline/manual without any API keys.

DATABASE_URL=sqlite:///./stackforge.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional provider credentials (server-side only, never exposed to frontend)
STEAM_API_KEY=
FACEIT_API_KEY=
LEETIFY_API_KEY=
